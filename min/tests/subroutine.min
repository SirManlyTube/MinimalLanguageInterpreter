SET FLAG 1

GOSUB RUN_APP

SUBROUTINE RUN_APP
GOSUB DOUBLE_COUNTDOWN
GOSUB TEMP_CLOCK
GOSUB RUN_MATH_TESTS
GOSUB CHECK_FLAG

RETURN

SUBROUTINE DOUBLE_COUNTDOWN
SET I 2
IF NOT I JUMP 5
SUB I 1
GOSUB COUNTDOWN
JUMP -3

RETURN

SUBROUTINE COUNTDOWN
SET COUNT 60
IF NOT COUNT JUMP 6
PRINT COUNT
SUB COUNT 1
DELAY 17
JUMP -4

RETURN

SUBROUTINE TEMP_CLOCK
SET CLOCK 240
IF NOT CLOCK JUMP 6
PRINT CLOCK
SUB CLOCK 1
DELAY 17
JUMP -4

RETURN

SUBROUTINE RUN_MATH_TESTS
GOSUB ADDITION_TEST
GOSUB SUBTRACTION_TEST
GOSUB MULTIPLICATION_TEST
GOSUB DIVISION_TEST

RETURN

SUBROUTINE ADDITION_TEST
SET LHS 50
ADD LHS 50
PRINT LHS

RETURN

SUBROUTINE SUBTRACTION_TEST
SET LHS 50
SUB LHS 50
PRINT LHS

RETURN

SUBROUTINE MULTIPLICATION_TEST
SET LHS 50
MUL LHS 50
PRINT LHS

RETURN

SUBROUTINE DIVISION_TEST
SET LHS 50
DIV LHS 50
PRINT LHS

RETURN

SUBROUTINE CHECK_FLAG
IF FLAG GOSUB PRINT_FLAG

RETURN

SUBROUTINE PRINT_FLAG
PRINT FLAG

RETURN

END
